prefix_rule(pattern=["make"], decision="allow", justification="Run project Makefile targets")
prefix_rule(pattern=["make", "check"], decision="allow", justification="Run the full CloudSpells quality gate")
prefix_rule(pattern=["make", "check-file"], decision="allow", justification="Run a focused CloudSpells quality gate")
prefix_rule(pattern=[".venv/bin/ruff"], decision="allow", justification="Run repo lint and format checks")
prefix_rule(pattern=[".venv/bin/pyright"], decision="allow", justification="Run repo type checking")
prefix_rule(pattern=[".venv/bin/pytest"], decision="allow", justification="Run repo tests")
prefix_rule(pattern=[".venv/bin/vulture"], decision="allow", justification="Run dead-code checks")
prefix_rule(pattern=["git", "status"], decision="allow", justification="Inspect repository state")
prefix_rule(pattern=["git", "diff"], decision="allow", justification="Inspect local changes")
prefix_rule(pattern=["git", "log"], decision="allow", justification="Inspect repository history")
prefix_rule(pattern=["git", "add"], decision="allow", justification="Stage approved changes")
prefix_rule(pattern=["git", "commit"], decision="allow", justification="Commit approved changes")
prefix_rule(pattern=["git", "branch"], decision="allow", justification="Inspect and manage branches")
prefix_rule(pattern=["git", "checkout"], decision="allow", justification="Switch branches when requested")
prefix_rule(pattern=["git", "stash"], decision="allow", justification="Preserve local work when requested")
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden", justification="Destructive reset requires an explicit user workflow outside the default policy")
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden", justification="Force push is destructive and requires explicit approval")
prefix_rule(pattern=["git", "push", "-f"], decision="forbidden", justification="Force push is destructive and requires explicit approval")
prefix_rule(pattern=["rm", "-rf", "/"], decision="forbidden", justification="Dangerous filesystem deletion")
prefix_rule(pattern=["rm", "-rf", "~"], decision="forbidden", justification="Dangerous filesystem deletion")
